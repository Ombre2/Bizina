# ============================================================
# BIZINA BACKEND — Variables d'environnement requises
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================================

# Environnement (development | production | test)
NODE_ENV=development

# Port du serveur
PORT=3000

# ---- BASE DE DONNÉES ----
DATABASE_TYPE=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=bizina_user
DATABASE_PASS=VotreMotDePasseDB_ICI
DATABASE_NAME=bizina

# ---- JWT ----
# OBLIGATOIRE : Générez avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REMPLACEZ_PAR_UNE_VALEUR_ALEATOIRE_LONGUE
JWT_EXPIRES_IN=15m

# OBLIGATOIRE : Autre valeur aléatoire différente de JWT_SECRET
JWT_REFRESH_SECRET=REMPLACEZ_PAR_UNE_AUTRE_VALEUR_ALEATOIRE_LONGUE
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS ----
# URL du frontend autorisé (pas de trailing slash)
FRONTEND_URL=http://localhost:5173
